{
	"include": ["./src", "./test"],
	"compilerOptions": {
		// File Layout
		"baseUrl": ".",
		"outDir": "./dist",
		// Environment Settings
		"moduleResolution": "bundler",
		"module": "es2022",
		"target": "es2022",
		// Other
		"allowSyntheticDefaultImports": true,
		"noUncheckedSideEffectImports": true,
		"resolveJsonModule": true,
		"strict": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"checkJs": true
	}
}
