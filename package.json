{
	"name": "eslint-config-aether",
	"version": "2.0.3",
	"description": "A custom code style for ESLint.",
	"homepage": "https://github.com/vanruesc/eslint-config-aether",
	"main": "./dist/index.js",
	"license": "Zlib",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"keywords": [
		"eslint",
		"eslintconfig",
		"lint",
		"hint",
		"style",
		"syntax",
		"check",
		"typescript",
		"ts"
	],
	"author": {
		"name": "Raoul van Rüschen",
		"email": "vanruesc@outlook.de"
	},
	"repository": {
		"url": "git+https://github.com/vanruesc/eslint-config-aether.git"
	},
	"bugs": {
		"url": "https://github.com/vanruesc/eslint-config-aether/issues"
	},
	"files": [
		"dist"
	],
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"scripts": {
		"prebuild": "npm run clean",
		"build": "run-p build:*",
		"build:js": "node esbuild",
		"build:dts": "tsc -p tsconfig.d.json",
		"clean": "del-cli dist",
		"debug": "eslint --debug test",
		"pretest": "npm run build",
		"test": "eslint test",
		"prepublishOnly": "npm test"
	},
	"peerDependencies": {
		"eslint": "9.x.x"
	},
	"dependencies": {
		"@eslint/core": "1.x.x",
		"@eslint/js": "9.x.x",
		"@stylistic/eslint-plugin": "5.x.x",
		"typescript-eslint": "8.x.x",
		"globals": "17.x.x"
	},
	"devDependencies": {
		"del-cli": "7.x.x",
		"esbuild": "0.27.x",
		"npm-run-all": "4.x.x",
		"tslib": "2.x.x",
		"typescript": "5.9.x"
	}
}
