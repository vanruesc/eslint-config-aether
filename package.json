{
	"name": "eslint-config-aether",
	"version": "3.3.0",
	"description": "A custom code style for ESLint.",
	"license": "Zlib",
	"author": {
		"name": "Raoul van Rüschen",
		"email": "vanruesc@outlook.de"
	},
	"homepage": "https://github.com/vanruesc/eslint-config-aether",
	"repository": {
		"url": "git+https://github.com/vanruesc/eslint-config-aether.git"
	},
	"bugs": {
		"url": "https://github.com/vanruesc/eslint-config-aether/issues"
	},
	"keywords": [
		"eslint",
		"eslintconfig",
		"lint",
		"hint",
		"style",
		"syntax",
		"check",
		"typescript",
		"ts"
	],
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">= 22.22.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12 <13",
			"onFail": "error"
		}
	},
	"peerDependencies": {
		"eslint": ">=10 <11"
	},
	"dependencies": {
		"@eslint/core": "^1.2.1",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-plugin-jsdoc": "^65.4.4",
		"globals": "^17.14.0",
		"typescript-eslint": "^8.72.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"del-cli": "^8.0.1",
		"esbuild": "^0.28.2",
		"native-copyfiles": "^2.1.1",
		"npm-run-all": "^4.1.5",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "node esbuild",
		"clean": "del-cli dist test/generated",
		"tsc": "tsc -p tsconfig.d.json",
		"copy": "copyfiles \"test/src/**\" test/generated -u 2",
		"predebug": "run-s clean tsc build",
		"debug": "eslint --debug src",
		"fix": "eslint --fix test/generated",
		"report": "eslint src --format html --output-file eslintreport.html",
		"pretest": "run-s clean tsc build copy fix",
		"test": "node --import tsx test/test.ts",
		"prepublishOnly": "run-s test"
	}
}
